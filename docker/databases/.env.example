# =============================================================================
# NEXUS LOCAL DATABASES CONFIGURATION (.env.example)
# =============================================================================
# Cấu hình cổng và tài khoản mặc định cho 8 container PostgreSQL độc lập
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

USER_DB_PORT=5433
CATALOG_DB_PORT=5434
COMMERCE_DB_PORT=5435
LOG_DB_PORT=5436
AUCTION_DB_PORT=5437
FULFILLMENT_DB_PORT=5438
NOTIFICATION_DB_PORT=5439
WALLET_DB_PORT=5440
