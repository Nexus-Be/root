# =============================================================================
# NEXUS MICROSERVICES - ROOT ENVIRONMENT CONFIGURATION (.env)
# =============================================================================
# Tệp .env này đã được .gitignore bảo vệ.
# Docker Compose tự động nạp các biến trong tệp này khi chạy từ root.
# =============================================================================

# --- Môi Trường Chạy ---
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# CỔNG LOCALHOST CÁC DỊCH VỤ (HOST PORT MAPPING)
# =============================================================================
# 1. Hạ Tầng Dùng Chung (Infrastructure)
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
REDIS_PORT=6379
GRAFANA_PORT=3000
TEMPO_PORT_GRPC=4317
TEMPO_PORT_HTTP=4318
TEMPO_PORT_UI=3200

# 2. Cơ Sở Dữ Liệu PostgreSQL (Databases: 5433 -> 5440)
USER_DB_PORT=5433
CATALOG_DB_PORT=5434
COMMERCE_DB_PORT=5435
LOG_DB_PORT=5436
AUCTION_DB_PORT=5437
FULFILLMENT_DB_PORT=5438
NOTIFICATION_DB_PORT=5439
WALLET_DB_PORT=5440

# 3. Microservices Applications (8000 -> 8008)
GATEWAY_PORT=8000
USER_SERVICE_PORT=8001
CATALOG_SERVICE_PORT=8002
COMMERCE_SERVICE_PORT=8003
LOG_SERVICE_PORT=8004
AUCTION_SERVICE_PORT=8005
FULFILLMENT_SERVICE_PORT=8006
NOTIFICATION_SERVICE_PORT=8007
WALLET_SERVICE_PORT=8008
CHECKHEAL_SERVICE_PORT=8009


# =============================================================================
# CẤU HÌNH HẠ TẦNG (INFRASTRUCTURE CREDENTIALS & CONNECTION)
# =============================================================================
# Redis (Local Docker Container)
REDIS_CONNECTION_STRING=redis:6379

# RabbitMQ Message Bus
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=MatkhaucuaTui123@

# PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=MatkhaucuaTui123@


# =============================================================================
# CẤU HÌNH BẢO MẬT (SECURITY & JWT AUTHENTICATION)
# =============================================================================
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=dev-jwt-signature-secret-key-strictly-for-local-development-min-32-chars
