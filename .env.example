# =============================================================================
# NEXUS ROOT STACK - ENVIRONMENT
# =============================================================================
# Stack phẳng 10 service trong src/Services. Không chứa infrastructure và DB local.
# Infrastructure (Redis, Tempo, Prometheus, Grafana) chạy riêng bằng docker-compose.infra.yml.

ASPNETCORE_ENVIRONMENT=Development

# Service ports
GATEWAY_PORT=8080
USER_SERVICE_PORT=8001
CATALOG_SERVICE_PORT=8002
COMMERCE_SERVICE_PORT=8003
LOG_SERVICE_PORT=8004
AUCTION_SERVICE_PORT=8005
FULFILLMENT_SERVICE_PORT=8006
NOTIFICATION_SERVICE_PORT=8007
WALLET_SERVICE_PORT=8008
CHECKHEAL_SERVICE_PORT=8009

# Databases (Neon Cloud PostgreSQL, một database cho mỗi service)
USER_DB_CONNECTION=postgresql://<USERNAME>:<PASSWORD>@<HOST>/user?sslmode=require&channel_binding=require
CATALOG_DB_CONNECTION=postgresql://<USERNAME>:<PASSWORD>@<HOST>/catalog?sslmode=require&channel_binding=require
COMMERCE_DB_CONNECTION=postgresql://<USERNAME>:<PASSWORD>@<HOST>/commerce?sslmode=require&channel_binding=require
LOG_DB_CONNECTION=postgresql://<USERNAME>:<PASSWORD>@<HOST>/log?sslmode=require&channel_binding=require
AUCTION_DB_CONNECTION=postgresql://<USERNAME>:<PASSWORD>@<HOST>/auction?sslmode=require&channel_binding=require
FULFILLMENT_DB_CONNECTION=postgresql://<USERNAME>:<PASSWORD>@<HOST>/fulfillment?sslmode=require&channel_binding=require
NOTIFICATION_DB_CONNECTION=postgresql://<USERNAME>:<PASSWORD>@<HOST>/notification?sslmode=require&channel_binding=require
WALLET_DB_CONNECTION=postgresql://<USERNAME>:<PASSWORD>@<HOST>/wallet?sslmode=require&channel_binding=require

# Shared auth
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e
JWT_EXPIRATION_IN_MINUTES=60
INTERNAL_SERVICE_SECRET=eaT0Ombups70WJzd85CBBpp8rAno55SxKn1qvYBGH9e

# Shared Redis and tracing
REDIS_CONNECTION_STRING=redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# Downstream base URLs
USERS_SERVICE_URL=http://user-service:8001
CATALOG_SERVICE_URL=http://catalog-service:8002
COMMERCE_SERVICE_URL=http://commerce-service:8003
LOG_SERVICE_URL=http://log-service:8004
AUCTION_SERVICE_URL=http://auction-service:8005
FULFILLMENT_SERVICE_URL=http://fulfillment-service:8006
NOTIFICATION_SERVICE_URL=http://notification-service:8007
WALLET_SERVICE_URL=http://wallet-service:8008
CHECKHEAL_SERVICE_URL=http://checkheal-service:8009

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_SENDER_NAME=Nexus Ecosystem
SMTP_SENDER_EMAIL=tayduy0502@gmail.com
SMTP_USERNAME=tayduy0502@gmail.com
SMTP_PASSWORD=fduoxzipmiravgrz

# VNPay
VNPAY_TMN_CODE=<REPLACE_WITH_VNPAY_TMN_CODE>
VNPAY_HASH_SECRET=<REPLACE_WITH_VNPAY_HASH_SECRET>
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://localhost:8080/api/v1/wallets/vnpay/return
VNPAY_VERSION=2.1.0

# CheckHeal
# API điều khiển fail-closed: bỏ trống key thì trả 500 INTERNAL_CONFIGURATION_ERROR.
CHECKHEAL_API_KEY=nexus_dev_checkheal_api_key_2026
CHECKHEAL_CRON_INTERVAL=60
CHECKHEAL_HTTP_TIMEOUT=5
CHECKHEAL_DATABASE_TIMEOUT=5
CHECKHEAL_FAILURE_THRESHOLD=3
CHECKHEAL_USERS_URL=http://user-service:8001/health
CHECKHEAL_CATALOG_URL=http://catalog-service:8002/health
CHECKHEAL_COMMERCE_URL=http://commerce-service:8003/health
CHECKHEAL_LOG_URL=http://log-service:8004/health
CHECKHEAL_AUCTION_URL=http://auction-service:8005/health
CHECKHEAL_FULFILLMENT_URL=http://fulfillment-service:8006/health
CHECKHEAL_NOTIFICATION_URL=http://notification-service:8007/health
CHECKHEAL_WALLET_URL=http://wallet-service:8008/health

# Shared infrastructure ports, dùng bởi docker-compose.infra.yml
REDIS_PORT=6379
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT_GRPC=4317
TEMPO_PORT_HTTP=4318
TEMPO_PORT_UI=3200
