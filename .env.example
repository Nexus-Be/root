# =============================================================================
# NEXUS MICROSERVICES - ROOT ENVIRONMENT CONFIGURATION (.env)
# =============================================================================
# Tệp .env này đã được .gitignore bảo vệ.
# Docker Compose tự động nạp các biến trong tệp này khi chạy từ root.
# =============================================================================

# --- Môi Trường Chạy ---
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# CỔNG LOCALHOST CÁC DỊCH VỤ (HOST PORT MAPPING)
# =============================================================================
# 1. Hạ Tầng Dùng Chung (Infrastructure)
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
REDIS_PORT=6379
GRAFANA_PORT=3000
TEMPO_PORT_GRPC=4317
TEMPO_PORT_HTTP=4318
TEMPO_PORT_UI=3200

# 2. Cơ Sở Dữ Liệu PostgreSQL (Databases: 5433 -> 5440)
USER_DB_PORT=5433
CATALOG_DB_PORT=5434
COMMERCE_DB_PORT=5435
LOG_DB_PORT=5436
AUCTION_DB_PORT=5437
FULFILLMENT_DB_PORT=5438
NOTIFICATION_DB_PORT=5439
WALLET_DB_PORT=5440

# 3. Microservices Applications (8000 -> 8008)
GATEWAY_PORT=8000
USER_SERVICE_PORT=8001
CATALOG_SERVICE_PORT=8002
COMMERCE_SERVICE_PORT=8003
LOG_SERVICE_PORT=8004
AUCTION_SERVICE_PORT=8005
FULFILLMENT_SERVICE_PORT=8006
NOTIFICATION_SERVICE_PORT=8007
WALLET_SERVICE_PORT=8008
CHECKHEAL_SERVICE_PORT=8009


# =============================================================================
# CẤU HÌNH HẠ TẦNG (INFRASTRUCTURE CREDENTIALS & CONNECTION)
# =============================================================================
# Redis (Local Docker Container)
REDIS_CONNECTION_STRING=redis:6379

# RabbitMQ Message Bus
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# PostgreSQL 16 (Local Fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_DB_PASSWORD>

# =============================================================================
# CƠ SỞ DỮ LIỆU MICROSERVICES (DATABASE CONNECTION STRINGS - NEON CLOUD)
# =============================================================================
# User Service Database
USER_CONNECTION_STRING=Host=ep-still-glade-b36k57z5-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=user_db;Username=neondb_owner;Password=<REPLACE_WITH_USER_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
USERS_DB_CONNECTION=Host=ep-still-glade-b36k57z5-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=user_db;Username=neondb_owner;Password=<REPLACE_WITH_USER_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Catalog Service Database
CATALOG_CONNECTION_STRING=Host=ep-small-fire-a17p6358-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=category_db;Username=neondb_owner;Password=<REPLACE_WITH_CATALOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
CATALOG_DB_CONNECTION=Host=ep-small-fire-a17p6358-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=category_db;Username=neondb_owner;Password=<REPLACE_WITH_CATALOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

