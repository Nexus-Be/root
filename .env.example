# Log Service Database
LOG_CONNECTION_STRING=Host=ep-ancient-hill-a1z35hvt-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=log_db;Username=neondb_owner;Password=<REPLACE_WITH_LOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
LOG_DB_CONNECTION=Host=ep-ancient-hill-a1z35hvt-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=log_db;Username=neondb_owner;Password=<REPLACE_WITH_LOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Notification Service Database (Local fallback / TBD)
NOTIFICATION_CONNECTION_STRING=Host=localhost;Port=5439;Database=notification_db;Username=postgres;Password=<REPLACE_WITH_NOTIFICATION_DB_PASSWORD>
NOTIFICATION_DB_CONNECTION=Host=localhost;Port=5439;Database=notification_db;Username=postgres;Password=<REPLACE_WITH_NOTIFICATION_DB_PASSWORD>


# =============================================================================
# CẤU HÌNH BẢO MẬT (SECURITY & JWT AUTHENTICATION)
# =============================================================================
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api

# =============================================================================
# CHECKHEAL SERVICE & HEALTH PROBER SECURITY
# =============================================================================
