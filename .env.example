# =============================================================================
# NEXUS MICROSERVICES - ROOT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Sao chép tệp này thành .env để cấu hình khi chạy local hoặc Docker:
#   cp .env.example .env
# Điền các giá trị bí mật thực tế vào file .env (không commit file .env lên Git).
# =============================================================================

# --- Môi Trường Chạy ---
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# CỔNG LOCALHOST CÁC DỊCH VỤ (HOST PORT MAPPING)
# =============================================================================
# 1. Hạ Tầng Dùng Chung (Infrastructure)
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
REDIS_PORT=6379
GRAFANA_PORT=3000
TEMPO_PORT_GRPC=4317
TEMPO_PORT_HTTP=4318
TEMPO_PORT_UI=3200

# 2. Microservices Applications (Gateway 8080, Backend 8001 -> 8009)
GATEWAY_PORT=8080
USER_SERVICE_PORT=8001
CATALOG_SERVICE_PORT=8002
COMMERCE_SERVICE_PORT=8003
LOG_SERVICE_PORT=8004
AUCTION_SERVICE_PORT=8005
FULFILLMENT_SERVICE_PORT=8006
NOTIFICATION_SERVICE_PORT=8007
WALLET_SERVICE_PORT=8008
CHECKHEAL_SERVICE_PORT=8009

# 3. Cổng CSDL PostgreSQL Local (Nếu chạy container Postgres cục bộ 5433 -> 5440)
USER_DB_PORT=5433
CATALOG_DB_PORT=5434
COMMERCE_DB_PORT=5435
LOG_DB_PORT=5436
AUCTION_DB_PORT=5437
FULFILLMENT_DB_PORT=5438
NOTIFICATION_DB_PORT=5439
WALLET_DB_PORT=5440

# Tài khoản PostgreSQL mặc định cho container cục bộ
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<REPLACE_WITH_POSTGRES_PASSWORD>


# =============================================================================
# CẤU HÌNH HẠ TẦNG (INFRASTRUCTURE CREDENTIALS & CONNECTION)
# =============================================================================
# Redis In-Memory Store (Shared cho API Gateway Rate Limit & User Service OTP/Cache - Cổng 6379, 500MB)
REDIS_PORT=6379
REDIS_CONNECTION_STRING=redis:6379

# RabbitMQ Message Bus
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>

# OpenTelemetry Distributed Tracing (Tempo)
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317


# =============================================================================
# CƠ SỞ DỮ LIỆU MICROSERVICES (DATABASE CONNECTION STRINGS - NEON CLOUD HOẶC LOCAL)
# =============================================================================
# User Service Database
USER_CONNECTION_STRING=Host=ep-still-glade-b36k57z5-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=user_db;Username=neondb_owner;Password=<REPLACE_WITH_USER_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
USERS_DB_CONNECTION=Host=ep-still-glade-b36k57z5-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=user_db;Username=neondb_owner;Password=<REPLACE_WITH_USER_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Catalog Service Database
CATALOG_CONNECTION_STRING=Host=ep-icy-salad-az7mdfqt-pooler.c-3.ap-southeast-1.aws.neon.tech;Port=5432;Database=catalog_db;Username=neondb_owner;Password=<REPLACE_WITH_CATALOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
CATALOG_DB_CONNECTION=Host=ep-icy-salad-az7mdfqt-pooler.c-3.ap-southeast-1.aws.neon.tech;Port=5432;Database=catalog_db;Username=neondb_owner;Password=<REPLACE_WITH_CATALOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Commerce Service Database
COMMERCE_CONNECTION_STRING=Host=ep-bold-poetry-b501gcqr-pooler.c-7.us-east-2.aws.neon.tech;Port=5432;Database=commerce_db;Username=neondb_owner;Password=<REPLACE_WITH_COMMERCE_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
COMMERCE_DB_CONNECTION=Host=ep-bold-poetry-b501gcqr-pooler.c-7.us-east-2.aws.neon.tech;Port=5432;Database=commerce_db;Username=neondb_owner;Password=<REPLACE_WITH_COMMERCE_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Auction Service Database
AUCTION_CONNECTION_STRING=Host=ep-summer-shape-b3m9hy77-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=auction_db;Username=neondb_owner;Password=<REPLACE_WITH_AUCTION_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
AUCTION_DB_CONNECTION=Host=ep-summer-shape-b3m9hy77-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=auction_db;Username=neondb_owner;Password=<REPLACE_WITH_AUCTION_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Wallet Service Database
WALLET_CONNECTION_STRING=Host=ep-flat-frost-a1sets6g-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=wallet_db;Username=neondb_owner;Password=<REPLACE_WITH_WALLET_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
WALLET_DB_CONNECTION=Host=ep-flat-frost-a1sets6g-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=wallet_db;Username=neondb_owner;Password=<REPLACE_WITH_WALLET_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Fulfillment Service Database
FULFILLMENT_CONNECTION_STRING=Host=ep-snowy-field-b3pfk600-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=fulfillment_service;Username=neondb_owner;Password=<REPLACE_WITH_FULFILLMENT_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
FULFILLMENT_DB_CONNECTION=Host=ep-snowy-field-b3pfk600-pooler.c-4.ap-southeast-1.aws.neon.tech;Port=5432;Database=fulfillment_service;Username=neondb_owner;Password=<REPLACE_WITH_FULFILLMENT_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Log Service Database
LOG_CONNECTION_STRING=Host=ep-fancy-poetry-a1frv94q-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=log_db;Username=neondb_owner;Password=<REPLACE_WITH_LOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
LOG_DB_CONNECTION=Host=ep-fancy-poetry-a1frv94q-pooler.ap-southeast-1.aws.neon.tech;Port=5432;Database=log_db;Username=neondb_owner;Password=<REPLACE_WITH_LOG_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# Notification Service Database (Neon Cloud PostgreSQL)
NOTIFICATION_CONNECTION_STRING=Host=ep-green-hill-b5e070g5-pooler.c-7.us-east-2.aws.neon.tech;Port=5432;Database=notification_db;Username=neondb_owner;Password=<REPLACE_WITH_NOTIFICATION_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true
NOTIFICATION_DB_CONNECTION=Host=ep-green-hill-b5e070g5-pooler.c-7.us-east-2.aws.neon.tech;Port=5432;Database=notification_db;Username=neondb_owner;Password=<REPLACE_WITH_NOTIFICATION_DB_PASSWORD>;SSL Mode=Require;Trust Server Certificate=true

# =============================================================================
# CẤU HÌNH DỊCH VỤ EMAIL (SMTP CONFIGURATION - NOTIFICATION SERVICE)
# =============================================================================
# Mặc định sử dụng Google Gmail SMTP (miễn phí) qua Google App Password:
# 1. Bật 2FA tại https://myaccount.google.com/security
# 2. Tạo App Password tại https://myaccount.google.com/apppasswords (chọn tên "Nexus")
# 3. Điền tài khoản Gmail vào SMTP_USERNAME và mã 16 ký tự vào SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_SENDER_NAME=Nexus Ecosystem
SMTP_SENDER_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=


# =============================================================================
# CẤU HÌNH API GATEWAY
# =============================================================================
GATEWAY_AUTH_MODE=Enforce
USERS_SERVICE_URL=http://user-service:8001
CATALOG_SERVICE_URL=http://catalog-service:8002
COMMERCE_SERVICE_URL=http://commerce-service:8003
LOG_SERVICE_URL=http://log-service:8004
AUCTION_SERVICE_URL=http://auction-service:8005
FULFILLMENT_SERVICE_URL=http://fulfillment-service:8006
NOTIFICATION_SERVICE_URL=http://notification-service:8007
WALLET_SERVICE_URL=http://wallet-service:8008
HEALTHCHECK_SERVICE_URL=http://checkheal-service:8009


# =============================================================================
# CẤU HÌNH BẢO MẬT (SECURITY & JWT AUTHENTICATION)
# =============================================================================
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=<REPLACE_WITH_JWT_SIGNING_KEY_MIN_32_CHARS>
JWT_EXPIRATION_IN_MINUTES=60


# =============================================================================
# CHECKHEAL SERVICE & HEALTH PROBER SECURITY
# =============================================================================
CHECKHEAL_CRON_INTERVAL=60
CHECKHEAL_PROBE_TIMEOUT=10
CHECKHEAL_DEFAULT_ENABLED=false
CHECKHEAL_API_KEY=<REPLACE_WITH_CHECKHEAL_API_KEY>
