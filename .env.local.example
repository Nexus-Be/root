# CheckHeal
CHECKHEAL_API_KEY=nexus_dev_checkheal_api_key_2026
CHECKHEAL_CRON_INTERVAL=60
CHECKHEAL_HTTP_TIMEOUT=5
CHECKHEAL_DATABASE_TIMEOUT=5
CHECKHEAL_FAILURE_THRESHOLD=3
