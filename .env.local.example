CHECKHEAL_FULFILLMENT_URL=http://fulfillment-service:8006/health
CHECKHEAL_NOTIFICATION_URL=http://notification-service:8007/health
CHECKHEAL_WALLET_URL=http://wallet-service:8008/health

# Shared infrastructure ports, dùng bởi docker-compose.infra.yml
REDIS_PORT=6379
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
