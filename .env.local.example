# =============================================================================
# NEXUS MICROSERVICES - LOCAL ENVIRONMENT CONFIGURATION (.env.local.example)
# =============================================================================
# Hồ sơ môi trường sử dụng PostgreSQL Cục Bộ (Local Docker Databases: Ports 5433 -> 5440)
#
# Cách áp dụng:
#   cp .env.local.example .env
# =============================================================================

ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# CỔNG LOCALHOST CÁC DỊCH VỤ (HOST PORT MAPPING)
# =============================================================================
REDIS_PORT=6379
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT_GRPC=4317
TEMPO_PORT_HTTP=4318
TEMPO_PORT_UI=3200

GATEWAY_PORT=8080
USER_SERVICE_PORT=8001
CATALOG_SERVICE_PORT=8002
COMMERCE_SERVICE_PORT=8003
LOG_SERVICE_PORT=8004
AUCTION_SERVICE_PORT=8005
FULFILLMENT_SERVICE_PORT=8006
NOTIFICATION_SERVICE_PORT=8007
WALLET_SERVICE_PORT=8008
CHECKHEAL_SERVICE_PORT=8009

# =============================================================================
# CỔNG CSDL POSTGRESQL LOCAL (Cụm Local Databases 5433 -> 5440)
# =============================================================================
USER_DB_PORT=5433
CATALOG_DB_PORT=5434
COMMERCE_DB_PORT=5435
LOG_DB_PORT=5436
AUCTION_DB_PORT=5437
FULFILLMENT_DB_PORT=5438
NOTIFICATION_DB_PORT=5439
WALLET_DB_PORT=5440

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =============================================================================
# HẠ TẦNG DÙNG CHUNG (INFRASTRUCTURE)
# =============================================================================
REDIS_CONNECTION_STRING=redis:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# =============================================================================
# CHUỖI KẾT NỐI CSDL POSTGRESQL CỤC BỘ (LOCAL HOST: 5433 - 5440)
# =============================================================================
USER_CONNECTION_STRING=Host=localhost;Port=5433;Database=usermanagement_db;Username=postgres;Password=postgres
USERS_DB_CONNECTION=Host=localhost;Port=5433;Database=usermanagement_db;Username=postgres;Password=postgres

CATALOG_CONNECTION_STRING=Host=localhost;Port=5434;Database=category_db;Username=postgres;Password=postgres
CATALOG_DB_CONNECTION=Host=localhost;Port=5434;Database=category_db;Username=postgres;Password=postgres

COMMERCE_CONNECTION_STRING=Host=localhost;Port=5435;Database=commerce_db;Username=postgres;Password=postgres
COMMERCE_DB_CONNECTION=Host=localhost;Port=5435;Database=commerce_db;Username=postgres;Password=postgres

LOG_CONNECTION_STRING=Host=localhost;Port=5436;Database=log_db;Username=postgres;Password=postgres
LOG_DB_CONNECTION=Host=localhost;Port=5436;Database=log_db;Username=postgres;Password=postgres

AUCTION_CONNECTION_STRING=Host=localhost;Port=5437;Database=auction_db;Username=postgres;Password=postgres
AUCTION_DB_CONNECTION=Host=localhost;Port=5437;Database=auction_db;Username=postgres;Password=postgres

FULFILLMENT_CONNECTION_STRING=Host=localhost;Port=5438;Database=fulfillment_db;Username=postgres;Password=postgres
FULFILLMENT_DB_CONNECTION=Host=localhost;Port=5438;Database=fulfillment_db;Username=postgres;Password=postgres

NOTIFICATION_CONNECTION_STRING=Host=localhost;Port=5439;Database=notification_db;Username=postgres;Password=postgres
NOTIFICATION_DB_CONNECTION=Host=localhost;Port=5439;Database=notification_db;Username=postgres;Password=postgres

WALLET_CONNECTION_STRING=Host=localhost;Port=5440;Database=wallet_db;Username=postgres;Password=postgres
WALLET_DB_CONNECTION=Host=localhost;Port=5440;Database=wallet_db;Username=postgres;Password=postgres

# =============================================================================
# CẤU HÌNH API GATEWAY & MICROSERVICES URLS
# =============================================================================
GATEWAY_AUTH_MODE=Enforce
USERS_SERVICE_URL=http://user-service:8001
CATALOG_SERVICE_URL=http://catalog-service:8002
COMMERCE_SERVICE_URL=http://commerce-service:8003
LOG_SERVICE_URL=http://log-service:8004
AUCTION_SERVICE_URL=http://auction-service:8005
FULFILLMENT_SERVICE_URL=http://fulfillment-service:8006
NOTIFICATION_SERVICE_URL=http://notification-service:8007
WALLET_SERVICE_URL=http://wallet-service:8008
HEALTHCHECK_SERVICE_URL=http://checkheal-service:8009

# =============================================================================
# CẤU HÌNH BẢO MẬT (SECURITY & JWT)
# =============================================================================
JWT_ISSUER=http://localhost:8001
JWT_AUDIENCE=shoppingcart-api
JWT_SIGNATURE=your_jwt_super_secret_key_minimum_32_characters_here!
JWT_EXPIRATION_IN_MINUTES=60

# =============================================================================
# DỊCH VỤ EMAIL (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_SENDER_NAME=Nexus Ecosystem
SMTP_SENDER_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=

# =============================================================================
# CHECKHEAL SERVICE
# =============================================================================
CHECKHEAL_CRON_INTERVAL=60
CHECKHEAL_PROBE_TIMEOUT=10
CHECKHEAL_DEFAULT_ENABLED=false
CHECKHEAL_API_KEY=nexus_dev_checkheal_api_key_2026
