# =============================================================================
# NEXUS INFRASTRUCTURE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================

# --- RabbitMQ Platform Bus ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=<REPLACE_WITH_RABBITMQ_PASSWORD>
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Redis In-Memory Store (Shared 500MB - Rate Limit & User Cache) ---
REDIS_PORT=6379

# --- Grafana & Tempo Tracing ---
GRAFANA_PORT=3000
TEMPO_PORT_GRPC=4317
TEMPO_PORT_HTTP=4318
TEMPO_PORT_UI=3200
