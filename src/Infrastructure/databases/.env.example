# =============================================================================
# NEXUS LOCAL DATABASES CLUSTER - ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================
# Cấu hình cụm 8 cơ sở dữ liệu PostgreSQL cục bộ cho 8 Microservices
# Khởi chạy toàn bộ cụm:
#   docker compose -f src/Infrastructure/databases/docker-compose.yml up -d
# Khởi chạy riêng 1 DB (ví dụ User):
#   docker compose -f src/Infrastructure/databases/docker-compose.yml up -d postgres-user
# =============================================================================

# Thông tin xác thực PostgreSQL mặc định
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host Ports cho từng Microservice Database
USER_DB_PORT=5433
CATALOG_DB_PORT=5434
COMMERCE_DB_PORT=5435
LOG_DB_PORT=5436
AUCTION_DB_PORT=5437
FULFILLMENT_DB_PORT=5438
NOTIFICATION_DB_PORT=5439
WALLET_DB_PORT=5440
