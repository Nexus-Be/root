// ====================================================================================
// Project Nexus - Order & Cart (Commerce) Service (v2)
// Chuẩn hóa theo quy ước Microservices: PascalCase, PK là Id,
// 4 trường vòng đời CreatedAt, UpdatedAt, DeletedAt, IsDeleted,
// Bổ sung bảng AuditLogs, OrderRefunds, SystemSettings, DailyOrderSequences.
// ====================================================================================

Project ProjectNexusOrderService {
  database_type: 'PostgreSQL'
  Note: 'PROJECT NEXUS - ORDER & CART SERVICE DATABASE SCHEMA (v2)'
}

// ====================================================================================
// ENUMS
// ====================================================================================

Enum CartStatus {
  Active    [note: 'Giỏ hàng đang hoạt động']
  CheckedOut [note: 'Đã gom hàng chuyển sang thanh toán']
  Abandoned [note: 'Giỏ hàng bị bỏ quên']
}

Enum OrderStatus {
  PendingPayment    [note: 'Chờ thanh toán']
  PaymentProcessing [note: 'Đang xử lý giao dịch']
  Paid              [note: 'Đã thanh toán']
  Cancelled         [note: 'Đã hủy đơn']
  Expired           [note: 'Hết hạn thanh toán']
}

Enum SubOrderStatus {
  PendingPayment [note: 'Chờ thanh toán']
  Paid           [note: 'Đã thanh toán, chờ xác nhận']
  Confirmed      [note: 'Người bán đã nhận đơn (SellerAccepted)']
  Shipping       [note: 'Đang giao hàng (Shipped)']
  Delivered      [note: 'Đã giao hàng thành công']
  Completed      [note: 'Đơn hàng hoàn tất trọn vẹn']
  Cancelled      [note: 'Đã hủy đơn']
  Refunded       [note: 'Đã hoàn tiền đơn hàng']
}

Enum PaymentMethod {
  Wallet [note: 'Thanh toán qua ví Nexus']
  VnPay  [note: 'Thanh toán qua cổng VNPay']
  Cod    [note: 'Thanh toán khi nhận hàng']
}

Enum OrderActorRole {
  Buyer        [note: 'Người mua']
  Seller       [note: 'Người bán']
  Admin        [note: 'Quản trị viên']
  SupportStaff [note: 'Nhân viên CSKH/Hỗ trợ']
  System       [note: 'Hệ thống tự động']
}

Enum RefundStatus {
  Requested [note: 'Yêu cầu hoàn tiền đã ghi nhận']
  Completed [note: 'Hoàn tiền thành công']
  Failed    [note: 'Hoàn tiền thất bại']
}

Enum RefundType {
  Full    [note: 'Hoàn toàn bộ số tiền']
  Partial [note: 'Hoàn một phần số tiền']
}

Enum InvoiceStatus {
  Generated [note: 'Đã tạo hóa đơn']
  Failed    [note: 'Tạo hóa đơn thất bại']
}

Enum DiscountScopeType {
  System  [note: 'Toàn sàn (Admin tạo)']
  Shop    [note: 'Từng gian hàng (Seller tạo)']
  Product [note: 'Theo sản phẩm cụ thể']
}

Enum DiscountType {
  Percent [note: 'Giảm theo %']
  Fixed   [note: 'Giảm số tiền cố định']
}

Enum DiscountStatus {
  Draft    [note: 'Bản nháp']
  Active   [note: 'Đang kích hoạt']
  Inactive [note: 'Tạm ngưng sử dụng']
  Expired  [note: 'Hết hạn']
}

Enum DiscountScopeRefType {
  Shop     [note: 'Shop người bán']
  Product  [note: 'Sản phẩm']
  Sku      [note: 'Biến thể SKU']
  Category [note: 'Danh mục']
  All      [note: 'Tất cả']
}

Enum DiscountUsageStatus {
  Reserved [note: 'Đang giữ chỗ']
  Used     [note: 'Đã áp dụng thành công']
  Released [note: 'Đã giải phóng']
}

Enum SettingValueType {
  String  [note: 'Chuỗi ký tự']
  Integer [note: 'Số nguyên']
  Decimal [note: 'Số thập phân']
  Boolean [note: 'Đúng / Sai']
  Json    [note: 'JSON']
}

Enum SettingCategory {
  Reputation [note: 'Uy tín']
  Money      [note: 'Tiền tệ và phí sàn']
  Auction    [note: 'Quy tắc đấu giá']
  Timing     [note: 'Thời hạn và timeout']
  System     [note: 'Hệ thống chung']
}

Enum SequenceType {
  OrderNo        [note: 'Số đơn hàng con']
  AuctionOrderNo [note: 'Số đơn hàng đấu giá']
  InvoiceNo      [note: 'Số hóa đơn']
}

Enum CancellationReasonCode {
  BuyerChangedMind [note: 'Người mua đổi ý']
  OutOfStock       [note: 'Hết hàng']
  PaymentTimeout   [note: 'Quá hạn thanh toán']
  SellerRejected   [note: 'Người bán từ chối']
  Other            [note: 'Lý do khác']
}

Enum AuditAction {
  CartCheckout    [note: 'Thanh toán giỏ hàng']
  OrderCreate     [note: 'Tạo đơn hàng']
  OrderPay        [note: 'Thanh toán đơn hàng']
  OrderAccept     [note: 'Xác nhận đơn hàng']
  OrderCancel     [note: 'Hủy đơn hàng']
  DiscountCreate  [note: 'Tạo mã giảm giá']
  DiscountUpdate  [note: 'Cập nhật mã giảm giá']
  InvoiceGenerate [note: 'Tạo hóa đơn']
}

// ====================================================================================
// 1. NHÓM GIỎ HÀNG & ĐƠN HÀNG TỔNG (CARTS & MASTER ORDERS)
// ====================================================================================

Table Carts {
  Id uuid [pk, default: `gen_random_uuid()`]
  BuyerId uuid [not null, note: 'Cross-service Ref -> UserService.Users.Id']
  Status CartStatus [not null, default: 'Active']
  ItemCount int [not null, default: 0]
  SubtotalAmount numeric(18,2) [not null, default: 0]
  LastActivityAt timestamptz [not null, default: `now()`]
  RowVersion bigint [not null, default: 0]
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]

  indexes {
    BuyerId [name: 'idx_Carts_BuyerId']
  }
}

Table CartItems {
  Id uuid [pk, default: `gen_random_uuid()`]
  CartId uuid [not null]
  ProductId uuid [not null, note: 'Cross-service Ref -> CatalogService.Products.Id']
  SkuId uuid [not null, note: 'Cross-service Ref -> CatalogService.ProductVariants.Id']
  SellerId uuid [not null, note: 'Cross-service Ref -> UserService.Users.Id']
  Quantity int [not null]
  UnitPriceSnapshot numeric(18,2) [not null]
  ProductNameSnapshot text [not null]
  AddedAt timestamptz [not null, default: `now()`]
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]

  indexes {
    (CartId, SkuId) [unique, name: 'uq_CartItems_Cart_Sku']
    ProductId [name: 'idx_CartItems_ProductId']
  }
}

Table Orders {
  Id uuid [pk, default: `gen_random_uuid()`]
  CartId uuid
  BuyerId uuid [not null, note: 'Cross-service Ref -> UserService.Users.Id']
  Status OrderStatus [not null, default: 'PendingPayment']
  TotalAmount numeric(18,2) [not null]
  WalletTransactionId uuid [note: 'Cross-service Ref -> WalletService.WalletTransactions.Id']
  PaymentAttemptCount int [not null, default: 0]
  PaymentDeadlineAt timestamptz [not null]
  RowVersion bigint [not null, default: 0]
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]

  indexes {
    BuyerId [name: 'idx_Orders_BuyerId']
  }
  Note: 'Đơn hàng tổng (Master Order) gom từ phiên thanh toán giỏ hàng'
}

// ====================================================================================
// 2. NHÓM MÃ GIẢM GIÁ (DISCOUNT CODES)
// ====================================================================================

Table DiscountCodes {
  Id uuid [pk, default: `gen_random_uuid()`]
  Code varchar(100) [unique, not null]
  Name varchar(255) [not null]
  ScopeType DiscountScopeType [not null]
  OwnerSellerId uuid [note: 'Cross-service Ref -> UserService.Users.Id']
  DiscountType DiscountType [not null]
  DiscountValue numeric(18,2) [not null]
  MaxDiscountAmount numeric(18,2)
  MinOrderAmount numeric(18,2) [not null, default: 0]
  MaxUsesTotal int
  MaxUsesPerUser int
  UsedCount int [not null, default: 0]
  ReservedCount int [not null, default: 0]
  IsVisible boolean [not null, default: true]
  Status DiscountStatus [not null, default: 'Draft']
  StartsAt timestamptz
  EndsAt timestamptz
  CreatedBy uuid [note: 'Cross-service Ref -> UserService.Users.Id']
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]
}

Table DiscountCodeScopes {
  Id uuid [pk, default: `gen_random_uuid()`]
  DiscountCodeId uuid [not null]
  ScopeRefType DiscountScopeRefType [not null]
  ScopeRefId uuid [note: 'NULL khi ScopeRefType = All']
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]
}

Table DiscountCodeUsages {
  Id uuid [pk, default: `gen_random_uuid()`]
  DiscountCodeId uuid [not null]
  UserId uuid [not null, note: 'Cross-service Ref -> UserService.Users.Id']
  OrderId uuid
  SubOrderId uuid
  Status DiscountUsageStatus [not null, default: 'Reserved']
  DiscountAmount numeric(18,2) [not null, default: 0]
  ReservedAt timestamptz [not null, default: `now()`]
  UsedAt timestamptz
  ReleasedAt timestamptz
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]
}

// ====================================================================================
// 3. NHÓM ĐƠN HÀNG CHI TIẾT THEO SHOP & ĐẤU GIÁ (SUB-ORDERS & AUCTION ORDERS)
// ====================================================================================

Table SubOrders {
  Id uuid [pk, default: `gen_random_uuid()`]
  SubOrderNo varchar(100) [unique, not null]
  OrderId uuid [not null]
  BuyerId uuid [not null, note: 'Cross-service Ref -> UserService.Users.Id']
  SellerId uuid [not null, note: 'Cross-service Ref -> UserService.Users.Id']
  Status SubOrderStatus [not null, default: 'PendingPayment']
  PaymentMethod PaymentMethod [not null, default: 'Wallet']
  WalletTransactionId uuid [note: 'Cross-service Ref -> WalletService.WalletTransactions.Id']
  ShippingAddress jsonb [not null]
  ContactPhone varchar(50) [not null]
  ItemsAmount numeric(18,2) [not null, default: 0]
  ProductDiscountAmount numeric(18,2) [not null, default: 0]
  ShopDiscountAmount numeric(18,2) [not null, default: 0]
  PlatformMarkupAmount numeric(18,2) [not null, default: 0]
  SystemDiscountAmount numeric(18,2) [not null, default: 0]
  ShippingFeeAmount numeric(18,2) [not null, default: 0]
  TotalAmount numeric(18,2) [not null, default: 0]
  SellerReceiveAmount numeric(18,2) [not null, default: 0]
  PlatformFeeAmount numeric(18,2) [not null, default: 0]
  PaymentDeadlineAt timestamptz [not null]
  SellerRespondDeadlineAt timestamptz
  PaidAt timestamptz
  SellerAcceptedAt timestamptz
  ShippedAt timestamptz
  DeliveredAt timestamptz
  CompletedAt timestamptz
  CancelledAt timestamptz
  RowVersion bigint [not null, default: 0]
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]

  indexes {
    SubOrderNo [name: 'idx_SubOrders_SubOrderNo']
    OrderId [name: 'idx_SubOrders_OrderId']
    SellerId [name: 'idx_SubOrders_SellerId']
  }
  Note: 'Đơn hàng chi tiết theo từng Shop/Seller (SubOrder)'
}

Table SubOrderItems {
  Id uuid [pk, default: `gen_random_uuid()`]
  SubOrderId uuid [not null]
  ProductId uuid [not null, note: 'Cross-service Ref -> CatalogService.Products.Id']
  SkuId uuid [not null, note: 'Cross-service Ref -> CatalogService.ProductVariants.Id']
  SellerId uuid [not null, note: 'Cross-service Ref -> UserService.Users.Id']
  ProductNameSnapshot text [not null]
  SkuCodeSnapshot varchar(100)
  SkuAttributesSnapshot jsonb [not null, default: `{}`]
  ImageUrlSnapshot text
  Quantity int [not null]
  UnitPrice numeric(18,2) [not null]
  UnitPriceAfterDiscount numeric(18,2) [not null]
  LineTotal numeric(18,2) [not null]
  DiscountCodeId uuid
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]
}

Table AuctionOrders {
  Id uuid [pk, default: `gen_random_uuid()`]
  OrderNo varchar(100) [unique, not null]
  AuctionId uuid [unique, not null, note: 'Cross-service Ref -> AuctionService.Auctions.Id']
  BuyerId uuid [not null, note: 'Cross-service Ref -> UserService.Users.Id']
  SellerId uuid [not null, note: 'Cross-service Ref -> UserService.Users.Id']
  WinningBidId uuid [not null, note: 'Cross-service Ref -> AuctionService.Bids.Id']
  ProductId uuid [not null, note: 'Cross-service Ref -> CatalogService.Products.Id']
  SkuId uuid [note: 'Cross-service Ref -> CatalogService.ProductVariants.Id']
  ProductNameSnapshot text [not null]
  ImageUrlSnapshot text
  SkuAttributesSnapshot jsonb [not null, default: `{}`]
  WinningAmount numeric(18,2) [not null]
  ShippingAddress jsonb
  ContactPhone varchar(50)
  ShippingFeeAmount numeric(18,2)
  TotalAmount numeric(18,2)
  SellerReceiveAmount numeric(18,2) [not null]
  PlatformFeeAmount numeric(18,2) [not null]
  Status SubOrderStatus [not null, default: 'PendingPayment']
  PaymentMethod PaymentMethod [not null, default: 'Wallet']
  WalletTransactionId uuid [note: 'Cross-service Ref -> WalletService.WalletTransactions.Id']
  PaymentDeadlineAt timestamptz [not null]
  SellerRespondDeadlineAt timestamptz
  PaidAt timestamptz
  SellerAcceptedAt timestamptz
  ShippedAt timestamptz
  DeliveredAt timestamptz
  CompletedAt timestamptz
  CancelledAt timestamptz
  RowVersion bigint [not null, default: 0]
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]
}

// ====================================================================================
// 4. NHÓM LỊCH SỬ, HÓA ĐƠN, HỦY ĐƠN & HOÀN TIỀN (LIFECYCLE)
// ====================================================================================

Table OrderStatusHistories {
  Id uuid [pk, default: `gen_random_uuid()`]
  SubOrderId uuid
  AuctionOrderId uuid
  FromStatus SubOrderStatus
  ToStatus SubOrderStatus [not null]
  ChangedBy uuid [note: 'Cross-service Ref -> UserService.Users.Id']
  ActorRole OrderActorRole [not null, default: 'System']
  Reason text
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]
}

Table OrderInvoices {
  Id uuid [pk, default: `gen_random_uuid()`]
  InvoiceNo varchar(100) [unique, not null]
  OrderId uuid
  SubOrderId uuid
  AuctionOrderId uuid
  TotalAmount numeric(18,2) [not null]
  FileUrl text
  Status InvoiceStatus [not null, default: 'Generated']
  IssuedAt timestamptz [not null, default: `now()`]
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]
}

Table OrderCancellations {
  Id uuid [pk, default: `gen_random_uuid()`]
  SubOrderId uuid
  AuctionOrderId uuid
  CancelledBy uuid [note: 'Cross-service Ref -> UserService.Users.Id']
  ActorRole OrderActorRole [not null]
  ReasonCode CancellationReasonCode [not null]
  ReasonNote text
  WasPaid boolean [not null, default: false]
  RefundTransactionId uuid [note: 'Cross-service Ref -> WalletService.WalletTransactions.Id']
  InventoryReleased boolean [not null, default: false]
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]
}

Table OrderRefunds {
  Id uuid [pk, default: `gen_random_uuid()`]
  SubOrderId uuid [note: 'Hoàn 1 SubOrder của shop']
  AuctionOrderId uuid [note: 'Hoàn 1 đơn đấu giá']
  OrderId uuid [note: 'Hoàn toàn bộ đơn tổng']
  CancellationId uuid [note: 'Liên kết bản ghi hủy đơn (nếu có)']
  RefundType RefundType [not null, default: 'Full']
  Amount numeric(18,2) [not null]
  Status RefundStatus [not null, default: 'Requested']
  ReasonCode varchar(100) [not null]
  ReasonNote text
  ActorRole OrderActorRole [not null, default: 'System']
  RequestedBy uuid [note: 'Cross-service Ref -> UserService.Users.Id']
  WalletTransactionId uuid [note: 'Giao dịch thanh toán gốc']
  RefundTransactionId uuid [note: 'Giao dịch hoàn tiền thành công']
  RequestEventId uuid [note: 'Outbox Event ID để đối soát']
  FailureCode varchar(100)
  RequestedAt timestamptz [not null, default: `now()`]
  CompletedAt timestamptz
  FailedAt timestamptz
  RowVersion bigint [not null, default: 0]
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]
}

// ====================================================================================
// 5. NHÓM CẤU HÌNH & CHUỖI SINH MÃ (CONFIG & INFRASTRUCTURE)
// ====================================================================================

Table SystemSettings {
  Id uuid [pk, default: `gen_random_uuid()`]
  SettingKey varchar(100) [unique, not null]
  SettingValue text [not null]
  ValueType SettingValueType [not null, default: 'String']
  Category SettingCategory [not null]
  Description varchar(500)
  IsEditable boolean [not null, default: true]
  UpdatedBy uuid [note: 'Cross-service Ref -> UserService.Users.Id']
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]
  DeletedAt timestamptz
  IsDeleted boolean [not null, default: false]
}

Table DailyOrderSequences {
  SeqDate date [not null]
  SeqType SequenceType [not null]
  LastValue bigint [not null, default: 0]
  CreatedAt timestamptz [not null, default: `now()`]
  UpdatedAt timestamptz [not null, default: `now()`]

  indexes {
    (SeqDate, SeqType) [pk]
  }
}

// ====================================================================================
// 6. NHÓM NHẬT KÝ HỆ THỐNG (AUDIT LOGS)
// ====================================================================================

Table AuditLogs {
  Id uuid [pk, note: 'Guid.CreateVersion7()']
  ServiceName varchar(100) [not null, note: 'Tên Service phát sinh log']
  TraceId varchar(100) [note: 'Mã TraceId từ Activity.Current?.TraceId']
  UserId varchar(100) [note: 'ID người thao tác']
  UserName varchar(150) [note: 'Tên/Email người thao tác tại thời điểm log']
  Action AuditAction [not null, note: 'Loại hành động kiểm toán']
  EntityName varchar(100) [not null, note: 'Tên bảng/Class bị tác động']
  EntityId varchar(100) [not null, note: 'Khóa chính của bản ghi bị tác động']
  OldValues jsonb [note: 'Chuỗi JSON chứa các cột trước khi sửa/xóa']
  NewValues jsonb [note: 'Chuỗi JSON chứa các cột sau khi thêm/sửa']
  ChangedColumns jsonb [note: 'Mảng JSON lưu nhanh tên các cột bị sửa']
  IpAddress varchar(45) [note: 'Địa chỉ IPv4 hoặc IPv6']
  UserAgent varchar(500) [note: 'Thiết bị/Trình duyệt của người dùng']
  CreatedAt timestamptz [not null, default: `now()`, note: 'DateTime.UtcNow']
  IsSynced boolean [not null, default: false, note: 'Worker gom đẩy về AuditService']
}

// ====================================================================================
// QUAN HỆ KHÓA NGOẠI NỘI BỘ (INTERNAL RELATIONSHIPS)
// ====================================================================================

Ref: CartItems.CartId > Carts.Id [delete: cascade]
Ref: Orders.CartId > Carts.Id
Ref: SubOrders.OrderId > Orders.Id

Ref: DiscountCodeScopes.DiscountCodeId > DiscountCodes.Id [delete: cascade]
Ref: DiscountCodeUsages.DiscountCodeId > DiscountCodes.Id [delete: cascade]
Ref: DiscountCodeUsages.OrderId > Orders.Id
Ref: DiscountCodeUsages.SubOrderId > SubOrders.Id

Ref: SubOrderItems.SubOrderId > SubOrders.Id [delete: cascade]
Ref: SubOrderItems.DiscountCodeId > DiscountCodes.Id

Ref: OrderStatusHistories.SubOrderId > SubOrders.Id [delete: cascade]
Ref: OrderStatusHistories.AuctionOrderId > AuctionOrders.Id [delete: cascade]

Ref: OrderInvoices.OrderId - Orders.Id
Ref: OrderInvoices.SubOrderId - SubOrders.Id
Ref: OrderInvoices.AuctionOrderId - AuctionOrders.Id

Ref: OrderCancellations.SubOrderId - SubOrders.Id
Ref: OrderCancellations.AuctionOrderId - AuctionOrders.Id

Ref: OrderRefunds.SubOrderId > SubOrders.Id
Ref: OrderRefunds.AuctionOrderId > AuctionOrders.Id
Ref: OrderRefunds.OrderId > Orders.Id
Ref: OrderRefunds.CancellationId > OrderCancellations.Id
