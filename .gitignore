Project.CleanArchitecture
logs/
*.log

# Environment Variables & Secrets (DO NOT COMMIT)
.env
.env.*
.env.local
!.env.example
!.env.*.example

# Appsettings & Secrets (DO NOT COMMIT ORIGINALS - ONLY COMMIT *.example*)
appsettings*.json
!appsettings*.example.json
!appsettings.example.json
!appsettings.*.example.json

# Local tools & config
.tools/
nuget.config
*.zip

# .agent: track governance and skills, keep local plans and history private
.agents/*
!.agents/AGENTS.md
!.agents/rules/
!.agents/rules/**
!.agents/skills/
!.agents/skills/**
.agents/plan/
.agents/history/
.claude
.cursor
.claude/super-board/active
.claude/super-board/onboard-answers.json
.claude/super-board/onboard-staged/
.claude/super-board/backup/
.claude/super-board/inflight/
.claude/super-board/migrations/
.claude/super-board/upgrade.json
