Project.CleanArchitecture
logs/
*.log

# Environment Variables & Secrets (DO NOT COMMIT)
.env
.env.*
.env.local
!.env.example
!.env.*.example

# Appsettings & Secrets (DO NOT COMMIT ORIGINALS - ONLY COMMIT *.example*)
appsettings*.json
!appsettings*.example.json
!appsettings.example.json
!appsettings.*.example.json

# Local tools & config
.tools/
nuget.config
*.zip

# .agent: track governance, templates, and skills; keep personal plans/notes/decisions/docs/history/review private
.agents/*
!.agents/AGENTS.md
!.agents/rules/
!.agents/rules/**
!.agents/skills/
!.agents/skills/**
!.agents/plans/
.agents/plans/*
!.agents/plans/plan-template.md
!.agents/notes/
.agents/notes/*
!.agents/notes/note-master.template.md
!.agents/decisions/
.agents/decisions/*
!.agents/decisions/decision-template.md
.agents/docs/
.agents/history/
.agents/review/
.claude
.cursor/*
!.cursor/rules/
!.cursor/rules/**
.claude/super-board/active
.claude/super-board/onboard-answers.json
.claude/super-board/onboard-staged/
